# RunDB environment variables
#
# Copy to .env.local and fill in what you need:  cp .env.example .env.local
# Variables prefixed NEXT_PUBLIC_ are inlined into the client bundle; everything
# else is server-only and must never be exposed to the browser.

# ---------------------------------------------------------------------------
# Supabase (required for real-data mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by ingest scripts, privileged server actions, and maintenance.
# NEVER expose this in client code or public build output.
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback for scripts when NEXT_PUBLIC_SUPABASE_URL is not set.
# SUPABASE_URL=

# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------
# Enables Supabase-backed reads/writes. Defaults to on unless explicitly "false".
NEXT_PUBLIC_USE_REAL_DATA=true

# Dev only: allow local mock/starter data when NODE_ENV=development.
# Keep disabled on public deploys.
NEXT_PUBLIC_ALLOW_MOCK_DATA=false

# ---------------------------------------------------------------------------
# Admin / moderation
# ---------------------------------------------------------------------------
# Comma-separated list of emails granted admin access (server-only).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# External APIs (optional)
# ---------------------------------------------------------------------------
# Twitch/IGDB credentials for game metadata + covers (ingest only).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key: profile lookups and Steam account linking (server-only).
STEAM_WEB_API_KEY=

# RAWG API key: optional fallback for game ID resolution.
RAWG_API_KEY=

# ---------------------------------------------------------------------------
# Script-only knobs (normally passed inline, not stored in .env.local)
# ---------------------------------------------------------------------------
# SEED_JSON=            # JSON seed list for `npm run ingest:games`
# DRY_RUN=true          # `npm run ingest:worker` / ingest:games without writes
# TEST_RUN_WRITE=true   # scripts/phase5-e2e-real-data.ts: enable write tests
# NODE_TEST_BYPASS_ADMIN=1  # tests only (with NODE_ENV=test): skip admin check in ingest-queue action
